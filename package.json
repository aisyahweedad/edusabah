{
  "name": "k-aecs",
  "version": "0.1.0",
  "private": true,
  "description": "EduSabah — AI Citizen Engagement & Complaint Management System (Sabah education)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@k-aecs/api",
    "dev:bot": "turbo run dev --filter=@k-aecs/telegram-bot",
    "dev:worker": "turbo run dev --filter=@k-aecs/worker",
    "dev:web": "turbo run dev --filter=@k-aecs/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @k-aecs/database db:generate",
    "db:migrate": "pnpm --filter @k-aecs/database db:migrate",
    "db:seed": "pnpm --filter @k-aecs/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
