# ============================================================================
# EduSabah environment (copy to .env and fill in real values)
# .env is gitignored — NEVER commit secrets.
# ============================================================================

# --- General ---
NODE_ENV=development
TZ=Asia/Kuching
LOG_LEVEL=info

# --- PostgreSQL (pgvector) ---
DATABASE_URL=postgresql://kaecs:kaecs_secret@localhost:5432/kaecs
POSTGRES_USER=kaecs
POSTGRES_PASSWORD=kaecs_secret
POSTGRES_DB=kaecs

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=kaecs-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/kaecs-files

# --- Auth ---
AUTH_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=8h
SESSION_TTL_HOURS=24

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public URL of the API (where Telegram POSTs webhook updates)
PUBLIC_API_URL=http://localhost:3001

# --- AI models (OpenAI-compatible gateway) ---
# Qualified via packages/ai through Pi. Different providers may be plugged per role.
AI_CHAT_BASE_URL=http://localhost:4000
AI_CHAT_API_KEY=
AI_CHAT_MODEL=qwen3.8-27b
AI_CHAT_CONTEXT_WINDOW=32768

SECRETARY_AI_BASE_URL=
SECRETARY_AI_API_KEY=
SECRETARY_AI_MODEL=

AI_EMBED_BASE_URL=http://localhost:4000
AI_EMBED_API_KEY=
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIMENSIONS=1024

AI_STT_BASE_URL=
AI_STT_API_KEY=
AI_STT_MODEL=

# --- Web search (DuckDuckGo HTML, no API key; optional Tavily/Exa for prod) ---
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_MS=12000
TAVILY_API_KEY=
EXA_API_KEY=

# --- Harness (Pi) runtime guards ---
HARNESS_MAX_TURNS=12
HARNESS_STREAM_TIMEOUT_MS=120000
HARNESS_THINKING_LEVEL=low
# Audit: keep tool-call args in ai_tool_calls (contains PII — default keep, off writes only name)
AUDIT_KEEP_ARGS=true
